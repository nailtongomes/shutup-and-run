[Unit]
Description=fairlead — on-demand container slots
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/fairlead
Environment=FAIRLEAD_CONFIG=/etc/fairlead/config.toml
Environment=HOME=/root
EnvironmentFile=-/etc/fairlead/env
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
